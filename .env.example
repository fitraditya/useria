# Server
# tenant app (register/login/company dashboard) and admin app (SuperAdmin)
# run as separate processes on separate ports — see: make run-tenant / run-admin
SERVER_PORT=8080
ADMIN_PORT=9080
SERVER_ENV=development

# Database
# DB_DRIVER=mysql for production, sqlite for local dev
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=saas_oauth2
DB_SQLITE_PATH=./useria.db

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=86400

# Bootstrap SuperAdmin (used by: make seed-admin)
ADMIN_EMAIL=admin@useria.local
ADMIN_PASSWORD=change-me-now

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# Session
SESSION_SECRET=your-session-secret
SESSION_MAX_AGE=604800
